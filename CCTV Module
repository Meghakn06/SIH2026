<script>

/* =====================================================
                  LOGIN / ACCESS CONTROL
===================================================== */

function login() {

    const username =
        document.getElementById("username").value;

    const password =
        document.getElementById("password").value;

    /*
       DEMO LOGIN

       Username: officer
       Password: 1234

       In a real application,
       authentication must happen
       on the backend.
    */

    if (
        username === "officer" &&
        password === "1234"
    ) {

        document.getElementById("loginPage")
            .style.display = "none";

        document.getElementById("dashboard")
            .style.display = "block";

    }

    else {

        document.getElementById("error")
            .innerText =
            "Invalid officer credentials.";

    }

}


/* =====================================================
                       LOGOUT
===================================================== */

function logout() {

    document.getElementById("dashboard")
        .style.display = "none";

    document.getElementById("loginPage")
        .style.display = "flex";

}


/* =====================================================
                 SECTION NAVIGATION
===================================================== */

function showSection(sectionId, button) {

    const sections =
        document.querySelectorAll(".section");

    sections.forEach(section => {

        section.classList.remove("active");

    });


    document
        .getElementById(sectionId)
        .classList.add("active");


    const buttons =
        document.querySelectorAll(".tab-btn");

    buttons.forEach(btn => {

        btn.classList.remove("active");

    });


    button.classList.add("active");

}


/* =====================================================
                    CCTV ACCESS
===================================================== */

function openCCTV(institute) {

    const cctvButton =
        document.querySelectorAll(".tab-btn")[1];

    showSection("cctv", cctvButton);

    document.getElementById("instituteName")
        .innerText =
        "Institute: " + institute;

}


/* =====================================================
                  CAMERA SELECTION
===================================================== */

function selectCamera(
    camera,
    institute,
    location,
    online
) {

    document.getElementById("cameraTitle")
        .innerText =
        "📹 " + camera;

    document.getElementById("cameraLocation")
        .innerText =
        "Location: " + location;

    document.getElementById("instituteName")
        .innerText =
        "Institute: " + institute;


    if (online) {

        document.getElementById("cameraStatus")
            .innerHTML =
            "Status: <span class='online'>🟢 Online</span>";


        /*
           DEMO CCTV VIDEO

           In a real system this source would
           be replaced with the authorized
           CCTV streaming infrastructure.
        */

        document.getElementById("videoPlaceholder")
            .style.display = "none";

        document.getElementById("cctvVideo")
            .style.display = "block";

    }

    else {

        document.getElementById("cameraStatus")
            .innerHTML =
            "Status: <span class='offline'>🔴 Offline</span>";

        document.getElementById("videoPlaceholder")
            .style.display = "block";

        document.getElementById("videoPlaceholder")
            .innerHTML =

            "<h2>🔴 Camera Offline</h2>" +
            "<p>This CCTV camera is currently unavailable.</p>";

        document.getElementById("cctvVideo")
            .style.display = "none";

    }

}


/* =====================================================
                REPORT DOCUMENTATION
===================================================== */

function generateReport() {

    const institute =
        document.getElementById("docInstitute").value;

    const inspector =
        document.getElementById("docInspector").value;

    const remarks =
        document.getElementById("docRemarks").value;


    document.getElementById("generatedInstitute")
        .innerText = institute;

    document.getElementById("generatedInspector")
        .innerText = inspector;

    document.getElementById("generatedRemarks")
        .innerText = remarks;


    const today =
        new Date().toLocaleDateString();

    document.getElementById("generatedDate")
        .innerText = today;


    document.getElementById("generatedReport")
        .style.display = "block";

}


/* =====================================================
                  PRINT INSPECTION REPORT
===================================================== */

function printReport() {

    window.print();

}


/* =====================================================
                PRINT DOCUMENTATION
===================================================== */

function printDocumentation() {

    window.print();

}

</script>

