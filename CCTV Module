<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Government Inspection & CCTV System</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6f9;
    color: #222;
}

/* ---------------- LOGIN ---------------- */

#loginPage {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #173b6c, #2563a6);
}

.login-box {
    background: white;
    width: 380px;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.login-box h1 {
    text-align: center;
    margin-bottom: 10px;
}

.login-box p {
    text-align: center;
    color: #666;
    margin-bottom: 25px;
}

.login-box input {
    width: 100%;
    padding: 13px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 7px;
}

button {
    border: none;
    padding: 11px 18px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

.login-btn {
    width: 100%;
    margin-top: 15px;
    background: #2563a6;
    color: white;
}

.login-btn:hover {
    background: #173b6c;
}

#error {
    color: red;
    text-align: center;
    margin-top: 10px;
}

/* ---------------- DASHBOARD ---------------- */

#dashboard {
    display: none;
}

header {
    background: #173b6c;
    color: white;
    padding: 18px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h2 {
    font-size: 22px;
}

.logout {
    background: #dc3545;
    color: white;
}

.container {
    padding: 25px;
    max-width: 1300px;
    margin: auto;
}

.welcome {
    background: white;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.welcome h2 {
    margin-bottom: 8px;
}

/* ---------------- NAVIGATION ---------------- */

.tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.tab-btn {
    background: white;
    border: 1px solid #ddd;
}

.tab-btn.active {
    background: #2563a6;
    color: white;
}

.section {
    display: none;
}

.section.active {
    display: block;
}

/* ---------------- CARDS ---------------- */

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 18px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.card h3 {
    margin-bottom: 10px;
}

.card p {
    margin: 7px 0;
    color: #555;
}

.online {
    color: green;
    font-weight: bold;
}

.offline {
    color: red;
    font-weight: bold;
}

/* ---------------- CCTV ---------------- */

.cctv-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
}

.video-container {
    background: #111;
    min-height: 430px;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.video-container video {
    width: 100%;
    height: 430px;
    object-fit: cover;
}

.video-placeholder {
    color: white;
    text-align: center;
}

.camera-list {
    background: white;
    padding: 18px;
    border-radius: 12px;
}

.camera-item {
    padding: 13px;
    border-bottom: 1px solid #eee;
    cursor: pointer;
}

.camera-item:hover {
    background: #f0f4f8;
}

.camera-item:last-child {
    border-bottom: none;
}

/* ---------------- REPORT ---------------- */

.report {
    background: white;
    padding: 30px;
    border-radius: 12px;
    line-height: 1.8;
}

.report h2 {
    color: #173b6c;
    margin-bottom: 15px;
}

.report-section {
    margin-top: 20px;
    border-top: 1px solid #ddd;
    padding-top: 15px;
}

.check {
    margin: 7px 0;
}

.pass {
    color: green;
}

.fail {
    color: red;
}

.evidence {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 10px;
}

.evidence img {
    width: 180px;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
}

/* ---------------- DOCUMENTATION ---------------- */

.documentation {
    background: white;
    padding: 25px;
    border-radius: 12px;
}

textarea {
    width: 100%;
    height: 120px;
    margin-top: 10px;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
}

.generate {
    margin-top: 15px;
    background: #2563a6;
    color: white;
}

.generated-report {
    margin-top: 20px;
    padding: 20px;
    background: #f7f9fb;
    border-radius: 10px;
    display: none;
}

/* ---------------- RESPONSIVE ---------------- */

@media(max-width: 800px) {

    .cctv-layout {
        grid-template-columns: 1fr;
    }

    header {
        padding: 15px;
    }

    .container {
        padding: 15px;
    }
}
</style>
</head>


<body>


<!-- =====================================================
