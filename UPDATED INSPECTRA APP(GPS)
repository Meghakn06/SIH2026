class InspectorInfo {
  final String id;
  final String name;
  final bool available;
  final int workload;
  final double? latitude;
  final double? longitude;
  final List<String> expertise;
  final double? distanceToSite;

  InspectorInfo({
    required this.id,
    required this.name,
    required this.available,
    required this.workload,
    this.latitude,
    this.longitude,
    this.expertise = const [],
    this.distanceToSite,
  });

  factory InspectorInfo.fromJson(Map<String, dynamic> json) {
    final rawExpertise = json['expertise'] ?? json['skills'] ?? [];
    final expertise = rawExpertise is List
        ? rawExpertise.map((e) => e.toString().toLowerCase()).toList()
        : <String>[];

    double? number(dynamic value) {
      if (value == null) return null;
      return double.tryParse(value.toString());
    }

    return InspectorInfo(
      id: (json['id'] ?? json['inspectorId'] ?? '').toString(),
      name: (json['name'] ?? json['inspectorName'] ?? 'Inspector').toString(),
      available: json['available'] ?? json['isAvailable'] ?? true,
      workload: int.tryParse(
            (json['workload'] ?? json['currentWorkload'] ?? 0).toString(),
          ) ??
          0,
      latitude: number(json['latitude'] ?? json['inspectorLatitude']),
      longitude: number(json['longitude'] ?? json['inspectorLongitude']),
      expertise: expertise,
    );
  }

  InspectorInfo copyWith({double? distanceToSite}) {
    return InspectorInfo(
      id: id,
      name: name,
      available: available,
      workload: workload,
      latitude: latitude,
      longitude: longitude,
      expertise: expertise,
      distanceToSite: distanceToSite ?? this.distanceToSite,
    );
  }
}

class AiInspectionResult {
  final String inspectionVerification;
  final String finalStatus;
  final String summary;
  final String reason;
  final String recommendedAction;

  const AiInspectionResult({
    required this.inspectionVerification,
    required this.finalStatus,
    required this.summary,
    required this.reason,
    required this.recommendedAction,
  });

  factory AiInspectionResult.fromJson(Map<String, dynamic> json) {
    return AiInspectionResult(
      inspectionVerification:
          (json['inspectionVerification'] ??
                  json['verification'] ??
                  json['inspectionStatus'] ??
                  'REQUIRES REVIEW')
              .toString(),
      finalStatus:
          (json['finalStatus'] ?? json['status'] ?? 'REQUIRES REVIEW').toString(),
      summary: (json['summary'] ?? json['conclusion'] ?? '').toString(),
      reason: (json['reason'] ?? '').toString(),
      recommendedAction: (json['recommendedAction'] ??
              json['recommendation'] ??
              '')
          .toString(),
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'inspectionVerification': inspectionVerification,
      'finalStatus': finalStatus,
      'summary': summary,
      'reason': reason,
      'recommendedAction': recommendedAction,
    };
  }
}

