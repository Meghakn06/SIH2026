// WORK ALLOCATION
// ===============================================================

class WorkAllocationService {
  static Future<InspectorInfo?> selectSuitableInspector({
    required Map<String, dynamic> inspection,
    required String authToken,
  }) async {
    try {
      final response = await http.get(
        Uri.parse('${AppConfig.apiBaseUrl}/inspectors'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $authToken',
        },
      );

      if (response.statusCode == 200) {
        final decoded = jsonDecode(response.body);
        final list = decoded is List
            ? decoded
            : (decoded['inspectors'] ?? <dynamic>[]) as List;

        final inspectors = list
            .map(
              (e) => InspectorInfo.fromJson(
                Map<String, dynamic>.from(e as Map),
              ),
            )
            .where((i) => i.available)
            .toList();

        final selected = _selectByScore(
          inspectors: inspectors,
          inspection: inspection,
        );

        if (selected != null) return selected;
      }
    } catch (e) {
      debugPrint('Inspector API unavailable: $e');
    }

    // Demo fallback. This is rule-based, not real AI.
    final demoInspectors = <InspectorInfo>[
      InspectorInfo(
        id: 'INS-101',
        name: 'Ananya',
        available: true,
        workload: 2,
        latitude: 12.9716,
        longitude: 77.5946,
        expertise: ['safety', 'electrical'],
      ),
      InspectorInfo(
        id: 'INS-102',
        name: 'Rahul',
        available: true,
        workload: 4,
        latitude: 12.9352,
        longitude: 77.6245,
        expertise: ['fire', 'safety'],
      ),
      InspectorInfo(
        id: 'INS-103',
        name: 'Megha',
        available: true,
        workload: 1,
        latitude: 12.9850,
        longitude: 77.6200,
        expertise: ['electrical', 'industrial'],
      ),
    ];

    return _selectByScore(
      inspectors: demoInspectors,
      inspection: inspection,
    );
  }

  static InspectorInfo? _selectByScore({
    required List<InspectorInfo> inspectors,
    required Map<String, dynamic> inspection,
  }) {
    if (inspectors.isEmpty) return null;

    final siteLat = _toDouble(
      inspection['latitude'] ?? inspection['siteLatitude'],
    );
    final siteLng = _toDouble(
      inspection['longitude'] ?? inspection['siteLongitude'],
    );

    final priority =
        (inspection['priority'] ?? inspection['concern'] ?? 'normal')
            .toString()
            .toLowerCase();

    final type = (inspection['inspectionType'] ??
            inspection['type'] ??
            inspection['concern'] ??
            '')
        .toString()
        .toLowerCase();

    final scored = <MapEntry<InspectorInfo, double>>[];

    for (final inspector in inspectors) {
      double score = 0;

      // Lower workload is better.
      score += math.max(0, 30 - inspector.workload * 5);

      // Availability is already filtered, but keep a strong preference.
      if (inspector.available) score += 25;

      // Priority: for urgent/high-priority jobs, distance matters more.
      final distance = _distanceIfPossible(
        inspector.latitude,
        inspector.longitude,
        siteLat,
        siteLng,
      );

      if (distance != null) {
        score += math.max(0, 30 - distance / 1000);
        if (priority == 'high' || priority == 'urgent' || priority == 'critical') {
          score += math.max(0, 20 - distance / 2000);
        }
      }

      // Expertise/inspection-type match.
      if (type.isNotEmpty &&
          inspector.expertise.any(
            (skill) => type.contains(skill) || skill.contains(type),
          )) {
        score += 25;
      }

      scored.add(
        MapEntry(
          inspector.copyWith(distanceToSite: distance),
          score,
        ),
      );
    }

    scored.sort((a, b) => b.value.compareTo(a.value));
    return scored.first.key;
  }

  static double? _distanceIfPossible(
    double? lat1,
    double? lng1,
    double? lat2,
    double? lng2,
  ) {
    if (lat1 == null || lng1 == null || lat2 == null || lng2 == null) {
      return null;
    }

    return Geolocator.distanceBetween(lat1, lng1, lat2, lng2);
  }

  static double? _toDouble(dynamic value) {
    if (value == null) return null;
    return double.tryParse(value.toString());
  }

  static Future<bool> assignInspection({
    required String inspectionId,
    required InspectorInfo inspector,
    required String authToken,
  }) async {
    try {
      final response = await http.post(
        Uri.parse('${AppConfig.apiBaseUrl}/inspections/assign'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $authToken',
        },
        body: jsonEncode({
          'inspectionId': inspectionId,
          'inspectorId': inspector.id,
          'inspectorName': inspector.name,
          'allocationReason': {
            'workload': inspector.workload,
            'distanceToSite': inspector.distanceToSite,
            'expertise': inspector.expertise,
          },
        }),
      );

      return response.statusCode == 200 || response.statusCode == 201;
    } catch (e) {
      debugPrint('Assignment API unavailable: $e');
      // Demo mode only.
      return authToken.startsWith('mock_') || authToken.startsWith('session_');
    }
  }
}

