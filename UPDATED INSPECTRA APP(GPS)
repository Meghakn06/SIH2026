    required this.siteData,
    required this.authToken,
    required this.inspectorId,
  });

  @override
  State<InspectionExecutionScreen> createState() =>
      _InspectionExecutionScreenState();
}

class _InspectionExecutionScreenState
    extends State<InspectionExecutionScreen> {
  Position? _currentPosition;
  File? _capturedImage;
  DateTime? _photoCapturedAt;

  bool _isGpsVerified = false;
  double? _distanceFromSite;
  String? _gpsMessage;

  bool _isSafetyHelmetChecked = false;
  bool _isFireExtinguisherChecked = false;

  // This remains an interface for your teammate's file-transfer/storage work.
  // Capturing a local image does NOT mean the file has been uploaded.
  String _evidenceStatus = 'missing';

  final TextEditingController _problemsController =
      TextEditingController();
  final TextEditingController _remarksController =
      TextEditingController();

  bool _isSubmitting = false;
  bool _isGeneratingSummary = false;

  AiInspectionResult? _aiResult;

  double? get _siteLatitude => _toDouble(
        widget.siteData['latitude'] ??
            widget.siteData['siteLatitude'] ??
            widget.siteData['site_latitude'],
      );

  double? get _siteLongitude => _toDouble(
        widget.siteData['longitude'] ??
            widget.siteData['siteLongitude'] ??
            widget.siteData['site_longitude'],
      );

  String get _siteName =>
      (widget.siteData['siteName'] ??
              widget.siteData['site_name'] ??
              'Inspection')
          .toString();

  @override
  void dispose() {
    _problemsController.dispose();
    _remarksController.dispose();
    super.dispose();
  }

  double? _toDouble(dynamic value) {
    if (value == null) return null;
    return double.tryParse(value.toString());
  }

  Future<void> _verifyGps() async {
    setState(() {
      _gpsMessage = 'Checking GPS location...';
      _isGpsVerified = false;
    });

    try {
      if (!await Geolocator.isLocationServiceEnabled()) {
        setState(() {
          _gpsMessage = 'Location services are disabled. Turn on GPS and retry.';
        });
        await NotificationService.sendEventToBackend(
          event: 'gps_verification_failed',
          authToken: widget.authToken,
          inspectorId: widget.inspectorId,
          inspectionId: widget.inspectionId,
          message: 'Location services are disabled.',
        );
        return;
      }

      var permission = await Geolocator.checkPermission();

      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
      }

      if (permission == LocationPermission.denied) {
        setState(() {
          _gpsMessage = 'Location permission was denied.';
        });
        return;
      }

      if (permission == LocationPermission.deniedForever) {
        setState(() {
          _gpsMessage =
              'Location permission is permanently denied. Enable it in phone settings.';
        });
        return;
      }

      if (_siteLatitude == null || _siteLongitude == null) {
        setState(() {
          _gpsMessage =
              'This inspection does not contain valid site latitude/longitude.';
        });
        return;
      }

      final pos= await Geolocator.getCurrentPosition(
  desiredAccuracy: LocationAccuracy.high,
);

      if (!mounted) return;

      // IMPORTANT FIX:
      // Save the actual GPS Position so latitude/longitude/accuracy used
      // during submission are the same values that were verified.
      _currentPosition = pos;

      final distance = Geolocator.distanceBetween(
        pos.latitude,
        pos.longitude,
        _siteLatitude!,
        _siteLongitude!,
      );

      _distanceFromSite = distance;

      final accuracyAcceptable =
          pos.accuracy > 0 &&
          pos.accuracy <= AppConfig.maxGpsAccuracyMeters;

      if (!accuracyAcceptable) {
        setState(() {
          _isGpsVerified = false;
          _gpsMessage =
              'GPS accuracy is ${pos.accuracy.toStringAsFixed(1)} m. '
              'Accuracy must be ${AppConfig.maxGpsAccuracyMeters.toStringAsFixed(0)} m or better.';
        });

        await NotificationService.sendEventToBackend(
          event: 'gps_accuracy_problem',
          authToken: widget.authToken,
          inspectorId: widget.inspectorId,
          inspectionId: widget.inspectionId,
          message:
              'GPS accuracy is insufficient: ${pos.accuracy.toStringAsFixed(1)} m.',
        );
        return;
      }

      if (distance <= AppConfig.siteRadiusMeters) {
        setState(() {
          _isGpsVerified = true;
          _gpsMessage =
              'GPS verified. Inspector is within ${AppConfig.siteRadiusMeters.toStringAsFixed(0)} m of the site.';
        });
      } else {
        setState(() {
          _isGpsVerified = false;
          _gpsMessage =
              'You are ${distance.toStringAsFixed(0)} m from the site. '
              'Move within ${AppConfig.siteRadiusMeters.toStringAsFixed(0)} m.';
        });

        await NotificationService.sendEventToBackend(
          event: 'gps_verification_failed',
          authToken: widget.authToken,
          inspectorId: widget.inspectorId,
          inspectionId: widget.inspectionId,
          message:
              'Inspector is ${distance.toStringAsFixed(0)} m away from the registered site.',
        );
      }
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _isGpsVerified = false;
        _gpsMessage = 'Unable to obtain GPS location. Please try again.';
      });

      await NotificationService.sendEventToBackend(
        event: 'gps_verification_failed',
        authToken: widget.authToken,
        inspectorId: widget.inspectorId,
        inspectionId: widget.inspectionId,
        message: 'GPS verification error: $e',
      );
    }
  }

  Future<void> _capturePhoto() async {
    try {
      final picker = ImagePicker();
      final pickedFile = await picker.pickImage(
        source: ImageSource.camera,
        imageQuality: 85,
      );

      if (pickedFile == null) return;

      setState(() {
        _capturedImage = File(pickedFile.path);
        _photoCapturedAt = DateTime.now();
        // Local capture exists, but upload is still the teammate's job.
        _evidenceStatus = 'captured_locally';
      });

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Photo captured locally. File transfer/storage is handled by the assigned module.',
          ),
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Camera error: $e')),
      );
    }
  }

  Future<void> _generateAiSummary() async {
    if (!_validateInspection(showMessage: true, forAi: true)) return;

    setState(() {
      _isGeneratingSummary = true;
      _aiResult = null;
    });

    final payload = _buildInspectionPayload(
      includeAiResult: false,
    );

    final result = await AiSummaryService.analyze(
      inspection: payload,
      authToken: widget.authToken,
    );

    if (!mounted) return;

    setState(() {
      _aiResult = result;
      _isGeneratingSummary = false;
    });

    if (result.inspectionVerification == 'REQUIRES REVIEW' ||
        result.inspectionVerification == 'INCOMPLETE') {
      await NotificationService.sendEventToBackend(
        event: 'inspection_requires_review',
        authToken: widget.authToken,
        inspectorId: widget.inspectorId,
        inspectionId: widget.inspectionId,
        message: 'Inspection has been flagged for review.',
      );
    }
  }

  bool _validateInspection({
    required bool showMessage,
    bool forAi = false,
  }) {
    String? error;

    if (!_isGpsVerified) {
      error = 'GPS verification is required.';
    } else if (_distanceFromSite == null ||
        _distanceFromSite! > AppConfig.siteRadiusMeters) {
      error = 'Inspector must be within 100 metres of the site.';
    } else if (_currentPosition == null) {
      error = 'Current GPS position is missing. Verify GPS again.';
    } else if (_currentPosition!.accuracy >
        AppConfig.maxGpsAccuracyMeters) {
      error = 'GPS accuracy is insufficient.';
    } else if (!_isSafetyHelmetChecked) {
      error = 'Safety helmet checklist item is not passed.';
    } else if (!_isFireExtinguisherChecked) {
      error = 'Fire extinguisher checklist item is not passed.';
    } else if (_evidenceStatus != 'submitted' && !forAi) {
      error =
          'Required evidence has not been marked as submitted. Complete the file-transfer module first.';
    } else if (_evidenceStatus == 'missing') {
      error = 'Required evidence is missing.';
    }

    if (error != null && showMessage && mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(error)),
      );
    }

    return error == null;
  }

  Map<String, dynamic> _buildInspectionPayload({
    required bool includeAiResult,
  }) {
    return {
      'inspectionId': widget.inspectionId,
      'inspectorId': widget.inspectorId,
      'inspectorName': widget.siteData['inspectorName'],
      'siteName': _siteName,
      'siteLatitude': _siteLatitude,
      'siteLongitude': _siteLongitude,
      'inspectorLatitude': _currentPosition?.latitude,
      'inspectorLongitude': _currentPosition?.longitude,
      'gpsAccuracy': _currentPosition?.accuracy,
      'distanceFromSite': _distanceFromSite,
      'gpsVerified': _isGpsVerified,
      'inspectionTimestamp': DateTime.now().toIso8601String(),
      'photoCapturedAt': _photoCapturedAt?.toIso8601String(),
      'evidenceStatus': _evidenceStatus,
      'checklist': {
        'safetyHelmetPresent': _isSafetyHelmetChecked,
        'fireExtinguisherValid': _isFireExtinguisherChecked,
        'inspectionPassed':
            _isSafetyHelmetChecked && _isFireExtinguisherChecked,
      },
      'problemsFound': _problemsController.text.trim(),
      'remarks': _remarksController.text.trim(),
      if (includeAiResult && _aiResult != null)
        'aiAnalysis': _aiResult!.toJson(),
    };
  }

  Future<void> _submitInspection() async {
    // The actual file transfer is teammate-owned. Therefore this screen
    // requires the evidence integration to report "submitted".
    if (!_validateInspection(showMessage: true)) return;

    setState(() => _isSubmitting = true);

    try {
      // Generate AI result automatically if the inspector has not already
      // generated it.
      if (_aiResult == null) {
        final result = await AiSummaryService.analyze(
          inspection: _buildInspectionPayload(includeAiResult: false),
          authToken: widget.authToken,
        );

        if (!mounted) return;
        setState(() => _aiResult = result);
      }

      final payload = _buildInspectionPayload(includeAiResult: true);

      final response = await http.post(
        Uri.parse('${AppConfig.apiBaseUrl}/process-inspection'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ${widget.authToken}',
        },
        body: jsonEncode(payload),
      );

      if (!mounted) return;

      if (response.statusCode == 200 || response.statusCode == 201) {
        final finalStatus =
            _aiResult?.finalStatus.toUpperCase() ?? 'REQUIRES REVIEW';

        await NotificationService.sendEventToBackend(
          event: 'inspection_final_result',
          authToken: widget.authToken,
          inspectorId: widget.inspectorId,
          inspectionId: widget.inspectionId,
          message: 'Inspection completed. Final result: $finalStatus.',
        );

        Navigator.pop(context, true);

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'Inspection submitted successfully. Result: $finalStatus',
            ),
          ),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'Server Error: ${response.statusCode}',
            ),
          ),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Submission Error: $e')),
        );
      }
    } finally {
      if (mounted) setState(() => _isSubmitting = false);
    }
  }

