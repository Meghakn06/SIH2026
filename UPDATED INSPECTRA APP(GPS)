// AI SERVICE
// ===============================================================

class AiSummaryService {
  static Future<AiInspectionResult> analyze({
    required Map<String, dynamic> inspection,
    required String authToken,
  }) async {
    try {
      final response = await http.post(
        Uri.parse('${AppConfig.apiBaseUrl}/ai/inspection-summary'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $authToken',
        },
        body: jsonEncode(inspection),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        if (data is Map<String, dynamic>) {
          final result = AiInspectionResult.fromJson(data);
          if (result.summary.trim().isNotEmpty ||
              result.finalStatus.trim().isNotEmpty) {
            return result;
          }
        }
      }
    } catch (e) {
      debugPrint('AI summary API unavailable: $e');
    }

    return _localFallback(inspection);
  }

  static AiInspectionResult _localFallback(
    Map<String, dynamic> inspection,
  ) {
    final checklist = Map<String, dynamic>.from(
      inspection['checklist'] ?? <String, dynamic>{},
    );

    final gps = inspection['gpsVerified'] == true;
    final accuracy =
        double.tryParse('${inspection['gpsAccuracy'] ?? ''}');
    final distance =
        double.tryParse('${inspection['distanceFromSite'] ?? ''}');
    final evidence =
        inspection['evidenceStatus']?.toString().toLowerCase() == 'submitted' ||
            inspection['photoCapturedAt'] != null;

    final helmet = checklist['safetyHelmetPresent'] == true;
    final fire = checklist['fireExtinguisherValid'] == true;
    final checklistComplete =
        checklist['safetyHelmetPresent'] != null &&
        checklist['fireExtinguisherValid'] != null;

    final problems = (inspection['problemsFound'] ?? '').toString().trim();

    if (!gps || distance == null || distance > AppConfig.siteRadiusMeters) {
      return const AiInspectionResult(
        inspectionVerification: 'REQUIRES REVIEW',
        finalStatus: 'REQUIRES REVIEW',
        summary: 'GPS/site verification did not satisfy the required criteria.',
        reason: 'The inspector was not successfully verified within the site radius.',
        recommendedAction: 'Verify the inspector location and inspection evidence.',
      );
    }

    if (accuracy == null || accuracy > AppConfig.maxGpsAccuracyMeters) {
      return const AiInspectionResult(
        inspectionVerification: 'REQUIRES REVIEW',
        finalStatus: 'REQUIRES REVIEW',
        summary: 'GPS accuracy is insufficient for a reliable verification.',
        reason: 'The reported GPS accuracy is missing or outside the accepted threshold.',
        recommendedAction: 'Repeat GPS verification with better location accuracy.',
      );
    }

    if (!checklistComplete || !evidence) {
      return const AiInspectionResult(
        inspectionVerification: 'INCOMPLETE',
        finalStatus: 'REQUIRES REVIEW',
        summary: 'Mandatory inspection information or evidence is missing.',
        reason: 'The checklist or required evidence was not fully submitted.',
        recommendedAction: 'Complete the mandatory inspection fields and evidence.',
      );
    }

    if (problems.isNotEmpty || !helmet || !fire) {
      return AiInspectionResult(
        inspectionVerification: 'PROPERLY INSPECTED',
        finalStatus: 'NON-COMPLIANT',
        summary: 'The inspection appears sufficiently documented, but compliance gaps were identified.',
        reason: problems.isNotEmpty
            ? 'Problems were reported in the inspection.'
            : 'One or more mandatory safety checks failed.',
        recommendedAction: 'Review the reported issues and take corrective action.',
      );
    }

    return const AiInspectionResult(
      inspectionVerification: 'PROPERLY INSPECTED',
      finalStatus: 'COMPLIANT',
      summary: 'The inspection appears sufficiently completed and the required checks passed.',
      reason: 'GPS verification, evidence and mandatory checklist checks were satisfied.',
      recommendedAction: 'No immediate corrective action indicated by the submitted data.',
    );
  }
}

