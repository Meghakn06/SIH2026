/// ===============================================================
/// INSPECTRA - INSPECTOR APP
/// ===============================================================
/// Team-owned modules intentionally NOT implemented here:
/// 1. Government/Admin login and dashboard.
/// 2. Actual photo/file upload and storage.
///
/// This file contains the inspector-side inspection logic:
/// - Inspector login/session
/// - Assigned inspections
/// - Automatic inspector allocation
/// - GPS verification with 100 m geofence
/// - GPS accuracy validation
/// - Compliance checklist
/// - Evidence status interface
/// - AI inspection verification
/// - AI final conclusion
/// - Inspection validation/submission
/// - OneSignal initialization
/// - Notification event hooks
///
/// IMPORTANT:
/// Change the backend URL and OneSignal App ID before production use.
/// A mobile app must NOT contain a OneSignal REST API key.
/// Server-triggered push notifications should be sent by your backend.
/// ===============================================================

class AppConfig {
  // Android emulator -> host machine.
  // For a physical phone, replace 10.0.2.2 with your computer's LAN IP.
  static const String apiBaseUrl = 'http://10.0.2.2:8000';

  // Replace with your real OneSignal App ID.
  // Do not put a OneSignal REST API key in this Flutter app.
  static const String oneSignalAppId = '7a30b42a-b8c8-4169-af3a-e06149588c1a';

  static const double siteRadiusMeters = 100.0;
  static const double maxGpsAccuracyMeters = 50.0;
}

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();

  try {
    await Firebase.initializeApp();
  } catch (e) {
    debugPrint('Firebase initialization skipped or failed: $e');
  }

  await NotificationService.initialize();

  runApp(const InspectraApp());
}

// ===============================================================
// ONESIGNAL / NOTIFICATION SERVICE
// ===============================================================

class NotificationService {
  static bool _initialized = false;

  static Future<void> initialize() async {
    if (AppConfig.oneSignalAppId == 'YOUR_ONESIGNAL_APP_ID') {
      debugPrint(
        'OneSignal is not initialized: replace AppConfig.oneSignalAppId.',
      );
      return;
    }

    try {
      OneSignal.initialize(AppConfig.oneSignalAppId);
      await OneSignal.Notifications.requestPermission(true);
      _initialized = true;
      debugPrint('OneSignal initialized.');
    } catch (e) {
      debugPrint('OneSignal initialization failed: $e');
    }
  }

  static bool get isInitialized => _initialized;

  /// Registers the logged-in inspector as the OneSignal external user.
  /// This does not send a notification; it identifies the device/user.
  static Future<void> identifyInspector(String inspectorId) async {
    if (!_initialized || inspectorId.trim().isEmpty) return;

    try {
      await OneSignal.login(inspectorId);
    } catch (e) {
      debugPrint('OneSignal inspector identification failed: $e');
    }
  }

  /// Local app-side hook. Actual remote push delivery should be triggered
  /// securely by the backend using OneSignal's server API.
  static Future<void> sendEventToBackend({
    required String event,
    required String authToken,
    required String inspectorId,
    String? inspectionId,
    String? message,
  }) async {
    if (authToken.isEmpty || authToken.startsWith('mock_')) {
      debugPrint(
        'Notification event [$event] not sent remotely because there is '
        'no real backend session.',
      );
      return;
    }

    try {
      final response = await http.post(
        Uri.parse('${AppConfig.apiBaseUrl}/notifications/trigger'),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $authToken',
        },
        body: jsonEncode({
          'event': event,
          'inspectorId': inspectorId,
          'inspectionId': inspectionId,
          'message': message,
        }),
      );

      if (response.statusCode < 200 || response.statusCode >= 300) {
        debugPrint(
          'Notification event failed: ${response.statusCode} ${response.body}',
        );
      }
    } catch (e) {
      debugPrint('Notification event backend unavailable: $e');
    }
  }
}

